# Financial Chatbot Configuration
# Copy this file to config.env and fill in your API keys

# ============================================================
# LLM Provider Configuration
# ============================================================

# Choose your LLM provider: openai, dashscope, deepseek
LLM_PROVIDER=dashscope

# ============================================================
# Dashscope (通义千问) Configuration - RECOMMENDED
# ============================================================
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_MODEL=qwen-max  # or qwen-plus, qwen-turbo

# ============================================================
# OpenAI Configuration
# ============================================================
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1  # Optional: custom endpoint
# OPENAI_MODEL=gpt-4  # or gpt-3.5-turbo

# ============================================================
# DeepSeek Configuration
# ============================================================
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# Enable LLM Mode
# ============================================================
# Set to true to enable LLM-powered intelligent responses
# Set to false to use direct mode (no API key needed)
ENABLE_LLM=true

# ============================================================
# Server Configuration
# ============================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=7860
SHARE=false  # Set to true to create public link
